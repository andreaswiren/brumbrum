{
  "name": "brumbrum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @brumbrum/client",
    "build": "npm run build -w @brumbrum/client",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "npm run preview -w @brumbrum/client"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
