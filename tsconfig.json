{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@brumbrum/configuration": ["packages/configuration/src/index.ts"],
      "@brumbrum/world-format": ["packages/world-format/src/index.ts"],
      "@brumbrum/protocol": ["packages/protocol/src/index.ts"]
    }
  },
  "include": ["apps", "packages"]
}
